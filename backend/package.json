{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "ts-node src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",

        "db:up": "cd ../docker && docker-compose up -d",
        "db:down": "cd ../docker && docker-compose down",
        "db:reset": "cd ../docker && docker-compose down -v && docker-compose up -d",

        "start:full": "npm run db:up && npm run dev"
    },
